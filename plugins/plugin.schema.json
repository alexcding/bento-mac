{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alexcding/Bento/plugins/plugin.schema.json",
  "title": "Bento plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "protocol",
    "capabilities"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "protocol": {
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "source",
          "publisher",
          "auth"
        ]
      },
      "uniqueItems": true
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "check",
          "install"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "check": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "install": {
            "type": "string"
          }
        }
      }
    },
    "auth": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "none"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "fields"
          ],
          "properties": {
            "kind": {
              "const": "secrets"
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "key",
                  "label"
                ],
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "help": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_interval_minutes",
        "cli"
      ],
      "properties": {
        "default_interval_minutes": {
          "type": "integer",
          "minimum": 1
        },
        "query_hint": {
          "type": "string"
        },
        "cli": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commands",
            "output"
          ],
          "properties": {
            "commands": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "match",
                  "args"
                ],
                "properties": {
                  "match": {
                    "type": "string",
                    "description": "Regex matched against the trimmed query; named groups become variables."
                  },
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                }
              }
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "output": {
              "enum": [
                "json",
                "json-lines",
                "text-lines"
              ]
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "default_limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "partial_output_ok": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
