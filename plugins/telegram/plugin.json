{
  "id": "telegram",
  "name": "Telegram",
  "version": "0.1.0",
  "protocol": 1,
  "capabilities": [
    "source"
  ],
  "description": "Posts from public Telegram channels, read from their public web preview (t.me/s). No login needed.",
  "source": {
    "default_interval_minutes": 10,
    "query_hint": "@channel or t.me/channel",
    "protocol": {
      "executable": "bento-plugin-telegram",
      "timeout_seconds": 45
    }
  }
}
