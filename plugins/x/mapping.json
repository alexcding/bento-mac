{
  "items": [
    "$.data",
    "$.tweets",
    "$.items",
    "$.results",
    "$"
  ],
  "external_id": [
    "$.id_str",
    "$.rest_id",
    "$.id"
  ],
  "url": [
    "$.url",
    "$.tweet_url",
    "https://x.com/{$.user.screen_name}/status/{$.id_str}",
    "https://x.com/{$.user.screen_name}/status/{$.id}",
    "https://x.com/{$.author.screen_name}/status/{$.id}",
    "https://x.com/{$.author.username}/status/{$.id}",
    "https://x.com/{$.screen_name}/status/{$.id}",
    "https://x.com/{$.username}/status/{$.id}",
    "https://x.com/i/web/status/{$.id_str}",
    "https://x.com/i/web/status/{$.id}"
  ],
  "text": [
    "$.full_text",
    "$.text"
  ],
  "author_name": [
    "$.user.name",
    "$.author.name",
    "$.name"
  ],
  "author_handle": [
    "$.user.screen_name",
    "$.author.screen_name",
    "$.author.username",
    "$.screen_name",
    "$.username"
  ],
  "author_avatar_url": [
    "$.user.profile_image_url_https",
    "$.user.profile_image_url",
    "$.author.profile_image_url",
    "$.author.avatar",
    "$.profile_image_url",
    "$.avatar_url"
  ],
  "published_at": [
    "$.created_at",
    "$.createdAt",
    "$.timestamp"
  ],
  "media": [
    {
      "type": "image",
      "each": "$.extended_entities.media[?@.type == 'photo']",
      "url": "$.media_url_https"
    },
    {
      "type": "video",
      "each": "$.extended_entities.media[?@.type == 'video' || @.type == 'animated_gif']",
      "url": [
        "$.expanded_url",
        "$.url"
      ],
      "thumbnail_url": "$.media_url_https",
      "duration": "$.video_info.duration_millis"
    },
    {
      "type": "image",
      "each": "$.media[?@.type == 'photo']",
      "url": [
        "$.media_url_https",
        "$.url"
      ]
    },
    {
      "type": "image",
      "each": "$.images[*]",
      "url": [
        "$.url",
        "$"
      ]
    }
  ],
  "reference": [
    {
      "type": "repost",
      "path": [
        "$.retweeted_status",
        "$.retweeted"
      ]
    },
    {
      "type": "quote",
      "path": [
        "$.quoted_status",
        "$.quoted",
        "$.quote"
      ]
    }
  ]
}
