// Shared build settings. Override any of them in Local.xcconfig (git-ignored); see
// Local.xcconfig.template.

PRODUCT_NAME = Bento
BENTO_BUNDLE_ID = io.github.alexcding.Bento
PRODUCT_BUNDLE_IDENTIFIER = $(BENTO_BUNDLE_ID)
MACOSX_DEPLOYMENT_TARGET = 15.0
SWIFT_VERSION = 6.0
ENABLE_HARDENED_RUNTIME = YES
// The embed script runs cargo and writes into the app bundle.
ENABLE_USER_SCRIPT_SANDBOXING = NO

// Default: ad-hoc signed, no iCloud. Runs locally with sync off.
BENTO_ICLOUD_CONTAINER =
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
CODE_SIGN_ENTITLEMENTS = Bento/Bento.entitlements
// The collector helper gets the keychain access group (iCloud Keychain) only when signed with a
// team; an ad-hoc binary with that entitlement would not launch.
BENTO_COLLECTOR_ENTITLEMENTS =

#include? "Local.xcconfig"
